BASE=http://localhost:3300

## Bước 2 – Trang chủ
$ curl -s -o /dev/null -w '%{http_code}' $BASE/
200
$ curl -s $BASE/ | grep -o 'Văn phòng điện tử Đoàn – Hội HIU' | head -1
Văn phòng điện tử Đoàn – Hội HIU

