# Public project coordinates. The publishable/anon key is safe for browser use;
# authorization still depends on RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-project-publishable-key

# Server-only. Never prefix this key with NEXT_PUBLIC_ or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Used to hash login/recovery throttling identifiers. Use a long random value.
AUTH_RATE_LIMIT_PEPPER=replace-with-a-random-server-only-value

# Public origin used in confirmation/recovery redirect URLs.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Mức log JSON phía server: debug | info | warn | error.
# Để trống thì theo môi trường: dev → debug, production → info, test → warn.
LOG_LEVEL=

# Lời gọi database chậm hơn ngưỡng này (mili giây) bị ghi log warn "db.slow". Để trống thì dùng 1000.
DB_SLOW_MS=

# VNPay sandbox, chỉ dùng phía server. Điền giá trị thật trong .env.local.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=
VNP_RETURN_URL=

# Chọn cổng: vnpay (mặc định) hoặc paypal. Giá trị thật chỉ đặt trong .env.local.
PAYMENT_PROVIDER=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_URL=
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
PAYPAL_VND_PER_USD=
